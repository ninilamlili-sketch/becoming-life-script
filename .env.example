# Copy to .env / Netlify site env. NEVER commit real secrets.
# Redeem is NOT live until these are set on Netlify + schema applied on Neon.

# Neon connection string (pooled / serverless recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# HMAC pepper for code hashing (long random string, e.g. openssl rand -hex 32)
CODE_PEPPER=

# HMAC secret for redeem JWTs (different from CODE_PEPPER)
REDEEM_JWT_SECRET=

# JWT lifetime in days (default 90)
REDEEM_JWT_TTL_DAYS=90

# Activate endpoint rate limit (per IP, process-local + optional DB audit)
REDEEM_RATE_LIMIT_MAX=10
REDEEM_RATE_LIMIT_WINDOW_SEC=900

# Ops only — void endpoint + scripts (optional until you need void)
ADMIN_SECRET=
